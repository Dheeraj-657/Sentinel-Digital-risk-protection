# Groq — used ONLY for the AI assessment/explanation layer (server-side).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# SQLite database for scan history
DATABASE_URL="file:./prisma/dev.db"

# demo = curated demo threat-intel dataset (no network calls besides Groq)
# live = adds real RDAP domain-age lookups and real HTTP redirect/content checks
INTEL_MODE=demo

# Max scans per client IP per minute
SCAN_RATE_LIMIT_PER_MINUTE=12
