# TRUSTGRAPH Module 2 environment (example — copy to .env and adjust)
# All variables are prefixed with TRUSTGRAPH_

# SQLite for local development; PostgreSQL in production:
# TRUSTGRAPH_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/trustgraph
TRUSTGRAPH_DATABASE_URL=sqlite:///./trustgraph_module2.db

TRUSTGRAPH_ENVIRONMENT=development
TRUSTGRAPH_LOG_LEVEL=INFO

# Module 1 (Brand DNA) = Sentinel DRP (teammate's Next.js service, port 3000).
# Leave unset to use the MOCK adapter.
TRUSTGRAPH_MODULE1_BASE_URL=http://localhost:3000

# Module 3 (Entity/Evidence, Phase 2 service, port 8001). Leave unset to use
# the MOCK adapter.
TRUSTGRAPH_MODULE3_BASE_URL=http://localhost:8001

# Worker execution: in_process (default) or sync (deterministic, for tests)
TRUSTGRAPH_WORKER_MODE=in_process

# ML model selection (see docs/modules/module-2/ML_ARCHITECTURE.md)
TRUSTGRAPH_TEXT_MODEL=char_ngram_tfidf
TRUSTGRAPH_VISUAL_MODEL=phash_hamming
TRUSTGRAPH_IDENTITY_MODEL=token_similarity

# Automatic threat discovery (P1). All three providers are enabled by default
# and are bounded (<=3 queries/provider, <=25 candidates/provider, <=40 total,
# <=10 chained analyses/job).
#   certificate_transparency: public crt.sh CT-log search — no credentials.
#   certspotter: public Cert Spotter CT-log search — no credentials
#     (anonymous rate limit applies; reported honestly as RATE_LIMITED).
#   web_search: Brave Search API. Without a key the provider is reported
#     UNCONFIGURED (honestly), never faked.
# TRUSTGRAPH_DISCOVERY_SEARCH_API_KEY=your-brave-search-api-key
# TRUSTGRAPH_DISCOVERY_CT_ENABLED=true
# TRUSTGRAPH_DISCOVERY_CERTSPOTTER_ENABLED=true
# TRUSTGRAPH_DISCOVERY_SEARCH_ENABLED=true
# TRUSTGRAPH_DISCOVERY_CT_BASE_URL=https://crt.sh
# TRUSTGRAPH_DISCOVERY_CERTSPOTTER_BASE_URL=https://api.certspotter.com
# TRUSTGRAPH_DISCOVERY_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# Module 4 — AI Security Analyst (POST /api/v1/investigation/analyst).
# Same variable names as Module 1's Groq configuration. Server-side only; never
# sent to the browser. Without a key the analyst answers with a deterministic,
# clearly labelled summary of the stored records.
# GROQ_API_KEY=gsk_your_key
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
